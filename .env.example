# --- Database (server-only) ---
MONGODB_URI=

# --- Auth.js (v5) ---
AUTH_SECRET=            # generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_URL=               # e.g. http://localhost:3000 (local) / https://your-domain.com (prod)
AUTH_TRUST_HOST=true    # required on Vercel / behind proxies

# --- Initial administrator (used only by the bootstrap script, Phase 4) ---
# Never commit real values. Remove or rotate after the first successful run.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD= # minimum 12 characters

# --- Cloudinary (server-only; Phase 7) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Phase 9) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo (sample) content ---
# Sample logos, testimonials, projects, contact details and imagery are shown ONLY in development by default.
# Set SHOW_DEMO_CONTENT=true for a private demo deployment, or false to preview the production view locally.
SHOW_DEMO_CONTENT=
