  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "cross-env NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/seed.ts",
    "db:check": "cross-env NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/db-check.ts",
    "design:apply": "cross-env NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/apply-design.ts",
    "demo": "cross-env NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/demo.ts",
    "setup": "npm run seed && npm run design:apply"
  },
